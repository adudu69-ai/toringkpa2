{
  "rules": {
    "ikpa_adj": {
      ".read": "auth != null && root.child('ikpa_adj/users/' + auth.uid + '/role').exists()",
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || (auth.uid === $uid && !root.child('ikpa_adj/config/bootstrapped').exists() && newData.child('role').val() === 'admin'))",
          ".validate": "newData.hasChildren(['role']) && newData.child('role').isString() && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'pengelola' || newData.child('role').val() === 'pembaca')"
        }
      },
      "config": {
        "bootstrapped": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === true && newData.parent().parent().child('users/' + auth.uid + '/role').val() === 'admin'"
        },
        "settings": {
          ".write": "auth != null && root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin'"
        }
      },
      "pengajuan": {
        "$pid": {
          ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')",
          "status": {
            ".validate": "newData.isString() && newData.val().length < 80"
          },
          "jalur": {
            ".validate": "newData.val() === 'SATKER' || newData.val() === 'ESELON_I' || newData.val() === 'BELUM_DIVERIFIKASI'"
          }
        }
      },
      "pengajuan_idx": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "by_satker": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "detail": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "exception": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "exc_open": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "exc_by_pengajuan": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "dedup_case": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "dedup_open": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "export": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "import_log": {
        ".write": "auth != null && (root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'admin' || root.child('ikpa_adj/users/' + auth.uid + '/role').val() === 'pengelola')"
      },
      "audit": {
        "$type": {
          "$id": {
            "$key": {
              ".write": "auth != null && !data.exists() && root.child('ikpa_adj/users/' + auth.uid + '/role').val() !== null && root.child('ikpa_adj/users/' + auth.uid + '/role').val() !== 'pembaca'"
            }
          }
        }
      },
      "audit_global": {
        "$key": {
          ".write": "auth != null && !data.exists() && root.child('ikpa_adj/users/' + auth.uid + '/role').val() !== null && root.child('ikpa_adj/users/' + auth.uid + '/role').val() !== 'pembaca'"
        }
      }
    }
  }
}